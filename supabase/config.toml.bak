# Supabase configuration file
# Learn more about this file at https://supabase.com/docs/guides/local-development/cli/config

[project]
# Reference name of your project in CLI commands
project_id = "dev_as"
# Hostname to use when connecting to the local API
# Can be overridden with the SUPABASE_HOST env variable
# (empty means localhost)
hostname = ""
# Port to use for the local API
# Can be overridden with the SUPABASE_PORT env variable
port = 54322
# The database version to use for the local environment
db_version = "15"
# Hostname of the machine which will be used to access the Supabase local environment
# Can be overridden with the SUPABASE_WORKSTATION_HOST env variable
workstation_host = "localhost"

[db]
# Port used by the local database (PostgreSQL)
# Can be overridden with the SUPABASE_DB_PORT env variable
port = 54321
# The database major version to use for the project
major_version = 15

[db.pooler]
enabled = true
# Port used by the local PgBouncer instance
port = 54329
# PgBouncer pool mode
pool_mode = "transaction"
# The number of PgBouncer maximum client connections, before it refuses new clients
max_client_conn = 100
# The number of PgBouncer default pool size, when it starts a new database pool
default_pool_size = 25

[studio]
# Port used by Supabase Studio
# Can be overridden with the SUPABASE_STUDIO_PORT env variable
port = 54323
# External URL of the API for the browser to use when serving the dashboard from Studio
api_url = ""

[inbucket]
# Port used by the email testing server
# Can be overridden with the SUPABASE_INBUCKET_PORT env variable
port = 54324

[vector]
enabled = true
# Port used by pgvector
port = 54328

[pgadmin]
enabled = true
# Port used by pgAdmin
port = 5050

[realtime]
enabled = true
# The maximum number of concurrent connections allowed.
max_concurrent_connections = 1024
# The maximum number of events allowed per client per second.
events_per_second = 100

[auth]
# The maximum number of seconds a sign-in session is valid for
# Default is 3600
session_expiry_window = 3600
# How often (in seconds) the server should refresh a user's session.
# Useful for updating auth token before expiration.
# Default is 60
# Setting to 0 turns off periodic refresh.
refresh_token_rotation_enabled = true

[functions]
# Configure one of: `python`, `nodejs`
python_version = "3.11"
# memory in mb for functions
memory_mb = 128
# timeout in seconds for functions
timeout_sec = 600
